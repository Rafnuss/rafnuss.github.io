.91,0.91,0.91,0.93,0.91,0.4,0.91,0.91,0.91,0.91,0.92,0.92,0.91]],"passage":[{"year":2007,"q10":null,"q50":null,"q90":null,"counted":0.56},{"year":2008,"q10":null,"q50":null,"q90":null,"counted":0.61},{"year":2009,"q10":null,"q50":null,"q90":null,"counted":0.59},{"year":2010,"q10":null,"q50":null,"q90":null,"counted":0.77},{"year":2011,"q10":null,"q50":null,"q90":null,"counted":0.89},{"year":2012,"q10":null,"q50":null,"q90":null,"counted":0.9},{"year":2013,"q10":null,"q50":null,"q90":null,"counted":0.77},{"year":2014,"q10":null,"q50":null,"q90":null,"counted":0.75},{"year":2015,"q10":null,"q50":null,"q90":null,"counted":0.76},{"year":2016,"q10":null,"q50":null,"q90":null,"counted":0.67},{"year":2017,"q10":null,"q50":null,"q90":null,"counted":0.82},{"year":2018,"q10":null,"q50":null,"q90":null,"counted":0.85},{"year":2019,"q10":null,"q50":null,"q90":null,"counted":0.99},{"year":2020,"q10":null,"q50":null,"q90":null,"counted":0.96},{"year":2021,"q10":null,"q50":null,"q90":null,"counted":0.93},{"year":2022,"q10":null,"q50":null,"q90":null,"counted":0.94},{"year":2023,"q10":null,"q50":null,"q90":null,"counted":1},{"year":2024,"q10":null,"q50":null,"q90":null,"counted":1},{"year":2025,"q10":null,"q50":null,"q90":null,"counted":0.97}],"chances":{"years":[2016,2025],"doy":[197.5,202.5,207.5,212.5,217.5,222.5,227.5,232.5,237.5,242.5,247.5,252.5,257.5,262.5,267.5,272.5,277.5,282.5,287.5,292.5,297.5,302.5,307.5,312.5,317.5,322.5],"days":[7,36,37,42,37,45,45,47,49,48,48,47,46,49,49,46,49,50,50,49,48,46,45,46,43,28]}},"daytime":{"method":"daytime@4","years":[2026,2026],"days":1,"birds":1,"main_days":1,"main_doy":null,"hours":null,"expected":null,"doy":[],"share":[],"change":{"days":[0,0],"show":false}},"weather":null,"age":null,"sex":null,"records":{"method":"records@2","top_days":[{"date":"2026-09-19","count":1,"notes":[{"source":"survey","ref":null,"text":"Un ancien spotteur du défilé débarque et c'est la débandade dans les airs ! De beaux flux d'hirondelles tout en matinée qui se stoppe très brutalement vers 14h00 pour laisser place à une après-midi assez vide malgré une petite couche nuageuse éparse. Quelques premiers passereaux se lancent dans la folle traversé partiel du monde. Ça donne envie pour les prochains jours !"}],"trektellen":"https://www.trektellen.org/count/view/2422/20260919"},{"date":"2022-08-20","count":0,"notes":[],"trektellen":"https://www.trektellen.org/count/view/2422/20220820"},{"date":"2023-08-17","count":0,"notes":[{"source":"count","ref":null,"text":"Premier de la saison"}],"trektellen":"https://www.trektellen.org/count/view/2422/20230817"},{"date":"2023-09-13","count":0,"notes":[{"source":"survey","ref":null,"text":"Fort passage d'hirondelles entre 10h et 11h."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230913"},{"date":"2024-08-26","count":0,"notes":[{"source":"survey","ref":null,"text":"Quelle belle journée ! Après les premières heures au cimetière plutôt calmes, le retour sur spot marque aussi et surtout le retour de la Bise ! Par où commencer... assurément par cette hermine qui passe en sautillant non loin le long d'une haie ! Puis les bondrées s'élancent, enfin :) ! Des jolis groupes réguliers ponctués de milans noirs, un grand merci à l'équipe présente aujourd'hui pour toutes ces détections complexes ! Parlons maintenant des cigognes, quelle journée !! Les groupes s'enchaînent toujours plus nombreux pour le régal de nos petits yeux.Les bondrées et milans finissent de passer à 20h, quelle motivation ! Enfin pour finir cette journée en beauté, c'est au tour du héron pourpré de se montrer en dessous de ses camarades cendrés :)"}],"trektellen":"https://www.trektellen.org/count/view/2422/20240826"},{"date":"2024-09-01","count":0,"notes":[{"source":"survey","ref":null,"text":"La matinée commence avec les cormorans habituels ! Arriverons les guêpiers et hirondelles avec de jolis groupes de guêpiers qui resterons en chasse juste au dessus du spot! Les cigognes continue le spectacle pour clore la matinée 3 cigognes noires. Ensuite arrivera un balbu qui devancera de nombreux busards des roseaux il y en avait partout dans la sphère de tout âge et sexe magique! Le spectacle sera stoppé par les orages... Pour conclure cette belle journée malgré les orages et la pluie un groupe de 65 hérons sortira du Rhône. Finalement il en passera 57 sous une pluie intense."}],"trektellen":"https://www.trektellen.org/count/view/2422/20240901"},{"date":"2024-09-03","count":0,"notes":[{"source":"survey","ref":null,"text":"Aujourd'hui les oiseaux n'ont pas été très pédagogiques pour les bénévoles car très hauts dans le ciel : bondrées, milans noirs, busards des roseaux mais aussi le premier Faucon hobereau de la saison. Les flux constants d'hirondelles ont permis aux spotteur de garder le regard vif sur la sphère. Petite pensée pour ce magnifique 3a de Busard des roseaux et pour ces 29 grands corbeaux qui nous ont rappelé à quel point la nature est belle et que nous sommes chanceux et chanceuses de pouvoir l'observer. Fin de protocole à 19h45 avant la fin du spot pour cause de mauvaise condition météorologique : 2 spotteurs trempés jusqu'aux os attendant la venue de leur sauveur, planqués dans les toilettes sèches."}],"trektellen":"https://www.trektellen.org/count/view/2422/20240903"},{"date":"2024-09-11","count":0,"notes":[{"source":"survey","ref":null,"text":"Vent de sud + pluie, les conditions n'étaient vraiment pas propices à la migration aujourd'hui... Les trois espèces de bergeronnettes passent tout de même, parfois ensemble, parfois à contre jour, plutôt pédagogique ! Pas un cri mais ce sont bien 2 ortolans qui passent assez hauts, encore une belle donnée pour le site :) Un courlis cendré pensait nous avoir loin entre les arbres mais non, Tiph' était à l'affut ! Le meilleur moment de la journée restera ce vol de fuligules milouins; il nous aura fait vivre un sacré ascenseur émotionnel ! Ils sortent d'abord du Rhône pour faire demi-tour, un semi plongeon sur l'Etournel puis un tour de sphère énorme pour finir par passer au dessus du le défilé ! L'espèce n'avait pas été contactée depuis 2015 en migration sur le site ! Une pluie intense s'installe à partir de 17h30..."}],"trektellen":"https://www.trektellen.org/count/view/2422/20240911"},{"date":"2024-09-12","count":0,"notes":[{"source":"survey","ref":null,"text":"\"Froid et lointain\" décrivent bien cette journée. Les toutes premières heures de comptage sont relativement calmes. Puis les oiseaux se lancent, aucune espèce dominante, un peu de tout, on est bien en septembre :) Ca sent la fin pour les bondrées, les jeunes ferment le rideau ! Le nombre de buses augmente fortement, ça fait plaisir à voir. Quelques martinets noirs se pointent également \"sûrement les derniers de la saison\" :) Dans l'après-midi, les rapaces passent très hauts de tous les côtés, pas évident à détecter... Puis aux alentours de 16h, un cri retentit tout proche, \"pipit à gorge rousse\" sans hésitation ! On ne parvient pas à mettre les yeux dessus, mais c'est seulement la 2ème donnée du site ! La fin de journée est très calme sous un froid à glacer le sang mais avec des magnifiques lumières !"}],"trektellen":"https://www.trektellen.org/count/view/2422/20240912"},{"date":"2025-08-14","count":0,"notes":[{"source":"survey","ref":null,"text":"Après la tempête de cette nuit, quelle belle surprise que de voir les toilettes sèches qui ont benné... Heureusement, elles ont à peu près survécu. Il manque le toit, et elles étaient tombées sur le nez... Beaucoup d'indécision chez les cormorans ce matin. Deux groupes passeront dans la matinée et les autres camperont sur le Rhône! Une aprem de plomb. Le café peut même plus refroidir avec toute cette chaleur. La soirée se finit en beauté sans oiseaux. Ah non, tout de même 1 héron et les deux 1ers colombins de la saison ! La fin de spot sonne, et nous fera pile décoller avant un gros orage. Nous avons eu le plaisir d'accueillir Guillaume Lacour sur spot, un néo dans le monde ornitho. Dédicace au Guillaume Lacour I d'Organbi ;)"}],"trektellen":"https://www.trektellen.org/count/view/2422/20250814"},{"date":"2025-08-15","count":0,"notes":[],"trektellen":"https://www.trektellen.org/count/view/2422/20250815"},{"date":"2025-08-17","count":0,"notes":[{"source":"survey","ref":null,"text":"La matinée se lance bien avec les cormorans, les premières printas sont aussi de la partie que dire de ses 2 loriot magnifique! La bise est bien présente on le sent bien... Départ du premier groupe de cigogne à 9h30. Après-midi finalement calme on attendra longtemps Toni (jeune cigogne baguée en allemagne) qu'on loupera dans le grand bleu loin côté Salève mais qui en 5h aura parcouru + de 250km joli moyenne pour passer la nuit dans les environs d'Avignon."}],"trektellen":"https://www.trektellen.org/count/view/2422/20250817"},{"date":"2025-08-20","count":0,"notes":[{"source":"survey","ref":null,"text":"Le temps se gatte au Défilé! Ca spotte depuis la voiture dès le milieu de matinée, essuyant la buée des vitres, mettant la manette des essuies glaces en position lente, le tout pour tenter de choper une 'tite craquenille. Finalement Pas de klaxon ce matin, et pas de craquenille non plus. Aujourd'hui il y a plus de lignes dans les noms d'observateurs à Organbi que d'observations au Défilé... Mais c'est normal avec ce temps... Le T déboule prendre le relais, de bonne humeur après avoir cassé son tel dans une folle et intrépide bataille de polochons la veille au soir... Dans l'aprem : Pluie, pluie, pluie, pluie, pluie, oh 2 hérons ! Pluie, pluie, pluie, pluie, GROSSE PLUIE, pluie pluie. Fin de spot, burgers !"}],"trektellen":"https://www.trektellen.org/count/view/2422/20250820"},{"date":"2025-08-22","count":0,"notes":[{"source":"survey","ref":null,"text":"Une journée sympa remplie de bénévoles ! Enfin un peu de bondrées, on en avait marre d'en voir passer sur tous les autres spots :) Réveil brumeux qui débute au Cimetière. Vers 12 h ça se lance enfin un peu. Mais une belle diversité se fait ressentir en fin d'aprem. Notamment un vol de 4 busards des roseaux. La soirée se termine avec des pompes de bondrées et de milans. Mais surtout avec la fête d'anniversaire de notre chère bénévole Christine !"}],"trektellen":"https://www.trektellen.org/count/view/2422/20250822"},{"date":"2025-09-01","count":0,"notes":[{"source":"survey","ref":null,"text":"Front pluvieux bloquant toute tentative de migration, jusqu'en milieu de matinée. Bon sang, ça grouille dans les buissons ! Tombée de gobemouches, fauvettes et pouillots probablement due à l'arrivée de la pluie au milieu de la nuit. En effet le radar à piafs de Sempach en Suisse était surmené pour le début du suivi nocturne. Quatre gobemouches noirs passeront assez haut dans le ciel, repérés par leurs cris de contact. Il faudra attendre onze heures avant que les hirondelles et les rapaces emboîtent le pas. Une aprem pluvieuse à souhait. Le T passera 4h dans sa caisse à attendre que la pluie s'arrête. 18h30, le radar pluie annonce grosse drache jusqu'au soir, alors le T remonte au logement. Le temps d'une douche, le T regarde par la fenêtre du logement. Mais c'est pas vrai il fait grand beau dehors ! Le T saute dans la caisse et oublie même le tél pro. Arrivé sur spot avec un magnifique arc-en-ciel, 2 très beaux groupes de printas se laisseront admirer !"}],"trektellen":"https://www.trektellen.org/count/view/2422/20250901"}]},"diagnostics":{"profile":"passerines","coverage_recent":0.792,"timed_days":1,"daytime_shift":null,"age_years":0,"flags":["borrowed_profile"]}}