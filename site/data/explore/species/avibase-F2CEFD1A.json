:"records@2","top_days":[{"date":"2023-07-15","count":0,"notes":[{"source":"survey","ref":null,"text":"Début de saison au Défilé de l'Ecluse. Et ça démarre joliment avec quelques groupes de martinets sur les crêtes du Jura dans la lumière matinale, suivis des premiers cormorans et Milans noirs.Bonnes observations tout le monde :)"}],"trektellen":"https://www.trektellen.org/count/view/2422/20230715"},{"date":"2023-07-17","count":0,"notes":[{"source":"survey","ref":null,"text":"Un petit flux de Milans noirs pour nous occuper entre 10h et 13h. Beaucoup plus calme en dehors de cette tranche horaire mais quelques observations sympathiques néanmoins dont ces Hérons pourprés en vol local dans la vallée du Rhône ou ce Balbuzard qui franchira le Vuache en toute fin de session."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230717"},{"date":"2023-07-18","count":0,"notes":[{"source":"survey","ref":null,"text":"Aujourd'hui encore un flux faible mais régulier de Milans noirs en fin de matinée et début d'après-midi, passant très majoritairement côté Jura. La fin de journée sera marquée par cette belle observation d'un groupe de 11 Hérons cendrés franchissant le Défilé."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230718"},{"date":"2023-07-19","count":0,"notes":[{"source":"survey","ref":null,"text":"Une journée dans la lignée des précédentes, avec un ciel qui se dégage complètement en cours d'après-midi, compliquant la recherche des milans. La première bondrée passera le Défilé en milieu de matinée accompagnée de 2 Milans noirs."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230719"},{"date":"2023-07-20","count":0,"notes":[{"source":"survey","ref":null,"text":"Une belle observation d'un groupe de Harles bièvres sur fond de Jura pour bien commencer une journée qui sera également marquée par le passage des premiers jeunes Milans royaux. Toujours assez calme côté Milans noirs."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230720"},{"date":"2023-07-21","count":0,"notes":[{"source":"survey","ref":null,"text":"Petite journée avec toutefois ces premières Grandes Aigrettes de la saison qui passeront en début de matinée au-dessus du Vuache."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230721"},{"date":"2023-07-22","count":0,"notes":[{"source":"survey","ref":null,"text":"Un effectif de Milans noirs en modeste hausse au regard du nombre d'observateurs présents ce jour sur le site à l'occasion des 30 ans du suivi salarié. Deux sympathiques observations de Harles bièvres descendant la vallée du Rhône en matinée."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230722"},{"date":"2023-07-24","count":0,"notes":[{"source":"survey","ref":null,"text":"Une journée ponctuée par le passage de beaux groupes de martinets. A partir de 18h, très beau spectacle de centaines d'oiseaux tournant dans la sphère d'observation sans véritable mouvement migratoire bien marqué."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230724"},{"date":"2023-07-25","count":0,"notes":[{"source":"survey","ref":null,"text":"Très net début de passage pour les hirondelles dont la migration était encore imperceptible depuis le spot il y a deux jours, avec notamment un joli départ du dortoir situé dans les roselières le long du Rhône."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230725"},{"date":"2023-07-26","count":0,"notes":[],"trektellen":"https://www.trektellen.org/count/view/2422/20230726"},{"date":"2023-07-27","count":0,"notes":[{"source":"survey","ref":null,"text":"Première journée avec une belle hausse des effectifs de Milans noirs."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230727"},{"date":"2023-07-28","count":0,"notes":[{"source":"survey","ref":null,"text":"Une chouette équipe franco-allemande pour compter les oiseaux sur le site aujourd'hui. Une pompe de Schwarzmilan par-ci, un vol de Mauersegler par-là. Meilleure journée jusqu'ici pour cette dernière espèce."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230728"},{"date":"2023-07-29","count":0,"notes":[{"source":"survey","ref":null,"text":"Un joli passage de martinets sous la pluie ce matin, beaucoup plus calme après 11h."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230729"},{"date":"2023-07-30","count":0,"notes":[{"source":"survey","ref":null,"text":"Première très belle journée pour le Milan noir. Une équipe nombreuse aura permis de dénombrer précisément tous ces groupes passant très haut dans le ciel."}],"trektellen":"https://www.trektellen.org/count/view/2422/20230730"},{"date":"2023-07-31","count":0,"notes":[],"trektellen":"https://www.trektellen.org/count/view/2422/20230731"}]},"diagnostics":{"profile":"passerines","coverage_recent":0.788,"timed_days":0,"daytime_shift":null,"age_years":0,"flags":["borrowed_profile","no_timed_days"]}}